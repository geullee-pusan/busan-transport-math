{
  "name": "busan-transport-math",
  "version": "0.0.0",
  "private": true,
  "description": "부산 교통 수학 — 부산 도시철도 노선도를 따라가며 배우는 수학",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-dist.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
