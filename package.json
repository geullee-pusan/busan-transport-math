    "graph": "node docs/curriculum/tools/validate-graph.mjs",
    "preview": "vite preview --port 4174 --strictPort",
    "tablet": "vite preview --port 4174 --strictPort --host",
    "icons": "node scripts/make-icons.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3"
  }
}
